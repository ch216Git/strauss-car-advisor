# Copy to backend/.env and fill in. Values here are examples only; never commit real secrets.

# The LLM provider key (see app/agent/providers/gemini.py).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Thinking tokens are billed as output: minimal | low (default) | medium | high | default (the model's own).
GEMINI_THINKING_LEVEL=low

# Signs the conversation-resume tokens the browser keeps for local history (app/agent/snapshot.py).
# HMAC key, not an encryption key: tokens are signed, not encrypted. Any non-empty string works;
# a long random value is best. If unset, the server uses an ephemeral key and logs one warning -
# resumed history then stops working after a restart. Keep it stable (and secret) to keep history.
HISTORY_SIGNING_KEY=change-me-to-a-long-random-string
