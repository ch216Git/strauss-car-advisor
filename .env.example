# Copy to backend/.env and fill in. Values here are examples only; never commit real secrets.
# The LLM provider key (see app/agent/providers/gemini.py). Put your real key only in backend/.env.
GEMINI_API_KEY=your-gemini-api-key
# A model your key can call generate_content on. Verified working: gemini-2.5-flash.
# The default "gemini-flash-latest" alias returned HTTP 404 for this key, so set an explicit model.
# List what your key allows with: python -c "from google import genai,os;[print(m.name) for m in genai.Client(api_key=os.environ['GEMINI_API_KEY']).models.list()]"
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Thinking tokens are billed as output: minimal | low | medium | high | default (the model's own).
# NOTE: gemini-2.5-flash rejects a thinking level ("Thinking level is not supported for this model").
# Use "default" with that model; the levels apply to models that support thinking_level (e.g. 3.x).
GEMINI_THINKING_LEVEL=default
# Signs the conversation-resume tokens the browser keeps for local history (app/agent/snapshot.py).
# HMAC key, not an encryption key: tokens are signed, not encrypted. Any non-empty string works;
# a long random value is best. If unset, the server uses an ephemeral key and logs one warning -
# resumed history then stops working after a restart. Keep it stable (and secret) to keep history.
HISTORY_SIGNING_KEY=change-me-to-a-long-random-string